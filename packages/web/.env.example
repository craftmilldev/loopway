# Locally, this is the Postgres from `npm run db:up` (docker-compose.yml). Required.
# On Vercel, the Supabase integration sets these. `npm run build` applies pending migrations before bundling, so a
# deploy migrates the database itself (a failing migration fails the build and the previous deployment stays live):
#   POSTGRES_URL              Supavisor in transaction mode (port 6543); what the server uses
#     postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   POSTGRES_URL_NON_POOLING  session mode (port 5432); what the build migrates
#     postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL* override them, for any other Postgres: the server uses DATABASE_URL_POOLED, else DATABASE_URL; the build
# migrates DATABASE_URL_UNPOOLED, else DATABASE_URL. Never point the build at a transaction-mode pooler.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/loopway
DATABASE_URL_POOLED=

# Tests create a throwaway database per test file on this server (default: the `npm run db:up` Postgres).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/postgres

# Optional. Base URL used when building webhook URLs for inboxes. Defaults to the request's origin.
# Also the URL /llms.txt names as the server to log in to.
PUBLIC_BASE_URL=

# Optional. Set to 1 on a self-hosted deploy: `/` redirects to `/login` instead of serving craftmill's landing page.
SELF_HOSTED=

# Login codes are emailed with Resend. Leave RESEND_API_KEY unset locally to print them to the console.
RESEND_API_KEY=
# The From address of those emails; its domain must be verified in Resend. Required when RESEND_API_KEY is set.
EMAIL_FROM=

# Signs session tokens (JWTs). Required. Generate with `openssl rand -hex 32`. Changing it logs everyone out.
TOKEN_SECRET=

# Encrypts inbox webhook secrets at rest (AES-256-GCM). Required, and needed at build time too: the build moves any
# plaintext secrets into their encrypted column. Generate with `openssl rand -base64 32`. Losing it loses every inbox
# secret; changing it makes them unreadable, so deliveries fail until they are set again.
INBOX_SECRET_KEY=

# Optional. Set to any non-empty value to turn on the routes under ee/, which are covered by ee/LICENSE (a commercial
# license, not the repo's). Unset, they aren't mounted and answer 404. Only presence is checked.
CRAFTMILL_ENTERPRISE_LICENSE=

# Optional, craftmill-hosted only, and only with CRAFTMILL_ENTERPRISE_LICENSE. The loopway inbox that "Request a source" on the New inbox form and "Something else…" on the new-bot harness picker post
# to: its webhook URL and inbox token. Leave unset and the form doesn't offer requests.
SOURCE_REQUEST_URL=
SOURCE_REQUEST_TOKEN=

# Optional. PostHog product metrics (webhooks received, logins, API errors by code),
# plus dashboard page views and clicks, which the browser sends through the /ingest proxy. Unset sends nothing.
# POSTHOG_HOST defaults to PostHog US cloud; set it for EU (https://eu.i.posthog.com) or self-hosted. An eu.* host
# also points the /ingest proxy and the browser at PostHog's EU cloud.
POSTHOG_API_KEY=
POSTHOG_HOST=

# Optional. The schedule options a deploy offers: "hour", "day" and "week", comma-separated. Default "day,week", which a Vercel Hobby cron
# (daily only) can drive. Turn on "hour" only where the cron in packages/web/vercel.json runs hourly ("0 * * * *", Vercel Pro).
SCHEDULE_OPTIONS=

PORT=3000
