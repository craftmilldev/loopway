# Leave DATABASE_URL unset locally to use PGlite (embedded Postgres) stored in PGLITE_DIR.
# On Vercel, set these from Neon → Connect:
#   DATABASE_URL         direct connection, used by `npm run db:migrate`
#     postgresql://<user>:<password>@ep-<name>.<region>.aws.neon.tech/neondb?sslmode=require
#   DATABASE_URL_POOLED  pooled connection (host has `-pooler`), used by the server when set
#     postgresql://<user>:<password>@ep-<name>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_URL_POOLED=

# Where PGlite keeps its data when DATABASE_URL is unset. Use "memory://" for a throwaway DB.
PGLITE_DIR=./.data/pglite

# Optional. Base URL used when building webhook URLs for inboxes. Defaults to the request's origin.
PUBLIC_BASE_URL=

# Login codes are emailed with Resend. Leave RESEND_API_KEY unset locally to print them to the console.
RESEND_API_KEY=

# Signs session tokens (JWTs). Required. Generate with `openssl rand -hex 32`. Changing it logs everyone out.
TOKEN_SECRET=

# Optional, craftmill-hosted only. The loopway inbox that "Request a source" on the New inbox form posts
# to: its webhook URL and inbox token. Leave unset and the form doesn't offer requests.
SOURCE_REQUEST_URL=
SOURCE_REQUEST_TOKEN=

# Optional. PostHog product metrics (webhooks received, logins, API errors by code),
# plus dashboard page views and clicks, which the browser sends through the /ingest proxy. Unset sends nothing.
# POSTHOG_HOST defaults to PostHog US cloud; set it for EU (https://eu.i.posthog.com) or self-hosted.
POSTHOG_API_KEY=
POSTHOG_HOST=

PORT=3000
