{
  "name": "@loopway/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "loopway HTTP API: webhook ingestion and the inbox/event API. Deployed to Vercel.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./db": "./src/db/index.ts",
    "./db/testing": "./src/db/testing.ts",
    "./store": "./src/store.ts",
    "./tokens": "./src/tokens.ts"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "start": "tsx scripts/dev.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@loopway/presets": "*",
    "@loopway/palette": "*",
    "@loopway/rules": "*",
    "@loopway/harnesses": "*",
    "@loopway/sources": "*",
    "ajv": "^8.20.0",
    "hono": "^4.13.13",
    "marked": "^18.1.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.438.7",
    "posthog-node": "^5.55.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
