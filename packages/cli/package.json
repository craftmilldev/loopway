    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
