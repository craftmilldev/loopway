{
  "name": "@loopway/cli",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "Command-line client for the loopway API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "loopway": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/bundle-analytics.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@loopway/harnesses": "*",
    "@loopway/palette": "*",
    "@loopway/presets": "*",
    "@loopway/rules": "*",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "posthog-node": "^5.55.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@craftmilldev/analytics": "^0.1.0",
    "@loopway/web": "*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
