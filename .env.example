# Leave DATABASE_URL unset locally to use PGlite (embedded Postgres) stored in PGLITE_DIR.
# On Vercel, set it to your Supabase *transaction pooler* URL (port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Where PGlite keeps its data when DATABASE_URL is unset. Use "memory://" for a throwaway DB.
PGLITE_DIR=./.data/pglite

# Optional. Base URL used when building webhook URLs for inboxes. Defaults to the request's origin.
PUBLIC_BASE_URL=

# Optional. When set, enables POST /admin/users with `Authorization: Bearer <token>`.
LOOPWAY_ADMIN_TOKEN=

PORT=3000
