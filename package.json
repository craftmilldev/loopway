{
  "name": "loopway",
  "version": "0.1.0",
  "private": true,
  "description": "Webhook ingestion into per-user CloudEvents inboxes, with a lock/claim/ack API for consumers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "start": "tsx scripts/dev.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "user:create": "tsx scripts/create-user.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
