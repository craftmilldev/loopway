{
  "name": "loopway",
  "version": "2.0.0-alpha",
  "private": true,
  "license": "MIT",
  "description": "Local polling for the collaboration tools your agents work in: loopway watches GitHub and tells you what changed.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/web",
    "packages/cli"
  ],
  "scripts": {
    "init-scratch": "node tools/init-scratch.mjs",
    "cli": "npm run start -w @loopway/cli --",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  }
}
