{
  "name": "loopway",
  "version": "0.1.0",
  "private": true,
  "description": "Webhook ingestion into per-user CloudEvents inboxes, with a lock/claim/ack API for consumers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/web",
    "packages/cli"
  ],
  "scripts": {
    "dev": "npm run dev -w @loopway/web",
    "start": "npm run start -w @loopway/web",
    "db:migrate": "npm run db:migrate -w @loopway/web",
    "cli": "npm run start -w @loopway/cli --",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  }
}
